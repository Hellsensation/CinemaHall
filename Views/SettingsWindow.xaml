<Window x:Class="CinemaHall.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/app.ico"
        Title="Настройки CinemaHall"
        Width="620" SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="28">

        <TextBlock Text="API-ключ Kinopoisk API Unofficial"
                   Foreground="{StaticResource TextBrush}"
                   FontSize="14" FontWeight="SemiBold"/>
        <TextBlock Text="Получите бесплатный ключ на kinopoiskapiunofficial.tech (200 запросов в сутки)."
                   Foreground="{StaticResource TextDimBrush}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,2,0,6"/>
        <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Папка с фильмами (видеофайлы в корне)"
                   Foreground="{StaticResource TextBrush}"
                   FontSize="14" FontWeight="SemiBold" Margin="0,18,0,6"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Обзор..." Margin="8,0,0,0"
                    Click="BrowseMoviesFolder_Click"/>
            <TextBox Text="{Binding MoviesFolder, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <TextBlock Text="Папка с сериалами (каждая подпапка — отдельный сериал)"
                   Foreground="{StaticResource TextBrush}"
                   FontSize="14" FontWeight="SemiBold" Margin="0,18,0,6"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Обзор..." Margin="8,0,0,0"
                    Click="BrowseSeriesFolder_Click"/>
            <TextBox Text="{Binding SeriesFolder, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <TextBlock Text="{Binding Error}"
                   Foreground="{StaticResource ErrorBrush}"
                   FontSize="13" TextWrapping="Wrap"
                   Margin="0,14,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" IsDefault="True"/>
            <Button Content="Отмена" IsCancel="True" Margin="8,0,0,0"/>
        </StackPanel>

    </StackPanel>
</Window>
