<Window x:Class="CinemaHall.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CinemaHall.Converters"
        Title="CinemaHall — каталог фильмов и сериалов"
        Height="800"
        Width="1280"
        MinHeight="600"
        MinWidth="960"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:PosterImageConverter x:Key="PosterImage"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Шаблон плитки афиши -->
        <DataTemplate x:Key="TileTemplate">
            <Border Width="180"
                    Margin="10"
                    CornerRadius="8"
                    Background="{StaticResource TileBrush}"
                    Padding="8">
                <StackPanel>
                    <Border CornerRadius="6"
                            Height="255"
                            Background="#101018"
                            ClipToBounds="True">
                        <Image Source="{Binding PosterLocalPath, Converter={StaticResource PosterImage}}"
                               Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13"
                            FontWeight="SemiBold"
                               TextWrapping="Wrap"
                            MaxHeight="38"
                               TextTrimming="CharacterEllipsis"
                               Margin="2,8,2,2"/>
                    <TextBlock Text="{Binding KindLabel}"
                               Foreground="{StaticResource TextDimBrush}"
                               FontSize="11"
                            Margin="2,2,2,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Верхняя панель: заголовок и кнопки -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBrush}"
                Padding="16,10">
            <DockPanel>
                <TextBlock Text="🎬 CinemaHall"
                           FontSize="18"
                        FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                    <Button Content="Обновить"
                            Command="{Binding RefreshCommand}"/>
                    <Button Content="Настройки"
                            Command="{Binding OpenSettingsCommand}"
                            Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Статусная строка -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource PanelBrush}"
                Padding="16,6">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{StaticResource TextDimBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Сетка плиток афиш (выделение передаётся в VM через SelectionChanged) -->
            <ListBox x:Name="TilesList"
                     ItemsSource="{Binding Items}"
                     ItemTemplate="{StaticResource TileTemplate}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="4"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            CornerRadius="8">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected"
                                                Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="{StaticResource TileSelectedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Панель описания выбранной афиши -->
            <Border Grid.Column="1"
                    Width="380"
                    Background="{StaticResource DetailBrush}"
                    Visibility="{Binding HasSelectedItem, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedItem}"
                            Margin="20">
                        <Border CornerRadius="10"
                                Height="340"
                                Background="#101018"
                                ClipToBounds="True">
                            <Image Source="{Binding PosterLocalPath, Converter={StaticResource PosterImage}}"
                                   Stretch="Uniform"/>
                        </Border>

                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="20"
                                FontWeight="Bold"
                                   TextWrapping="Wrap"
                                Margin="0,16,0,4"/>
                        <!-- Mode=OneWay обязателен: привязка Run.Text по умолчанию TwoWay,
                             а свойства только для чтения вызывают исключение -->
                        <TextBlock Foreground="{StaticResource TextDimBrush}"
                                FontSize="13"
                                Margin="0,0,0,2">
                            <Run Text="{Binding KindLabel, Mode=OneWay}"/>
                            <Run Text="{Binding RatingLabel, Mode=OneWay}"
                                    Foreground="#F5C518"/>
                        </TextBlock>
                        <TextBlock Text="{Binding GenresLabel}"
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="13"
                                TextWrapping="Wrap"/>

                        <TextBlock Text="{Binding Description}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="14"
                                LineHeight="21"
                                   TextWrapping="Wrap"
                                Margin="0,14,0,20"/>

                        <Button Content="▶  Смотреть"
                                Style="{StaticResource PlayButtonStyle}"
                                Command="{Binding DataContext.PlayCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
