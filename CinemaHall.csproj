<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Используем WPF вместо WinForms -->
    <UseWPF>true</UseWPF>
    <RootNamespace>CinemaHall</RootNamespace>
    <AssemblyName>CinemaHall</AssemblyName>
    <!-- Иконка exe (проводник, ярлык запуска) -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Иконка как WPF-ресурс для Icon у окон (панель задач, Alt-Tab) -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- MVVM-инфраструктура: ObservableObject, RelayCommand и т.д. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

</Project>
