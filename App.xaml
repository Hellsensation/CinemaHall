<Application x:Class="CinemaHall.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>

        <!-- Базовые цвета тёмной темы -->
        <SolidColorBrush x:Key="BgBrush"
                Color="#1B1B29"/>
        <SolidColorBrush x:Key="PanelBrush"
                Color="#151520"/>
        <SolidColorBrush x:Key="TileBrush"
                Color="#252538"/>
        <SolidColorBrush x:Key="TileSelectedBrush"
                Color="#34345A"/>
        <SolidColorBrush x:Key="DetailBrush"
                Color="#20202F"/>
        <SolidColorBrush x:Key="TextBrush"
                Color="#EAEAF2"/>
        <SolidColorBrush x:Key="TextDimBrush"
                Color="#8A8AA8"/>
        <SolidColorBrush x:Key="AccentBrush"
                Color="#E8544F"/>
        <SolidColorBrush x:Key="ErrorBrush"
                Color="#FF7B72"/>

        <!-- Стиль обычной кнопки -->
        <Style TargetType="Button">
            <Setter Property="Background"
                    Value="#2E2E4A"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="14,7"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#3C3C63"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#4A4A78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка «Смотреть» в фирменном цвете -->
        <Style x:Key="PlayButtonStyle"
                TargetType="Button"
                BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"
                    Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="FontSize"
                    Value="16"/>
            <Setter Property="Padding"
                    Value="24,12"/>
        </Style>

        <!-- Стиль текстового поля -->
        <Style TargetType="TextBox">
            <Setter Property="Background"
                    Value="#101018"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"
                    Value="#3C3C63"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="8,6"/>
            <Setter Property="CaretBrush"
                    Value="{StaticResource TextBrush}"/>
        </Style>

    </Application.Resources>
</Application>
